{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream-with-experimental-timestamps",
  "globalEnv": [
    "DATABASE_URL",
    "REACT_APP_BASE_URL",
    "GITHUB_CLIENT_SECRET",
    "HONO_API_URL",
    "GITHUB_CLIENT_ID",
    "MC_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        ".output/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "push": {
      "dependsOn": ["^push"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
