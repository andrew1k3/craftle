{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "license": "PROPRIETARY",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "demo-data-for": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "tsx": "^4.23.1"
  },
  "scripts": {
    "push": "pnpm drizzle-kit push",
    "generate": "pnpm drizzle-kit generate",
    "test": "pnpm dlx tsx ./src/data/test.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "development": "./src/db/schema.ts",
      "default": "./dist/db/schema.js"
    }
  }
}